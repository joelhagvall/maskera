{
  "name": "maskera-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Swedish-first, client-side PII redaction for AI apps",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm check:fixtures && pnpm -r test",
    "check:fixtures": "node scripts/check-fixture-identifiers.mjs",
    "smoke": "node scripts/pack-smoke.mjs",
    "typecheck": "for p in packages/core packages/ner apps/demo; do node node_modules/typescript-7/lib/tsc.js -p $p/tsconfig.json --noEmit || exit 1; done && node node_modules/typescript-7/lib/tsc.js -p packages/ner/tsconfig.runtime-test.json --noEmit",
    "eval": "node scripts/run-published-eval.mjs",
    "demo": "pnpm -C apps/demo dev",
    "lint": "pnpm check:fixtures && biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.27.10",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "0.6.0",
      "sharp": "^0.35.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "puppeteer"
    ],
    "patchedDependencies": {
      "@huggingface/transformers@4.2.0": "patches/@huggingface__transformers@4.2.0.patch"
    }
  }
}
