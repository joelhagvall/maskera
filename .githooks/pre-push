#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

node scripts/check-fresh-main.mjs
node scripts/harness/biome-ratchet.mjs
node scripts/check-benchmark-sync.mjs
node scripts/harness/check-product-sync.mjs
pnpm run check:tooling
pnpm run typecheck
pnpm -r test -- --sequence.shuffle

# Run pa11y against a fresh local build whenever outgoing commits touch apps/demo.
demo_changed=""
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  case "$remote_ref" in
    refs/tags/*) continue ;;
  esac
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base "$local_oid" origin/main 2>/dev/null || echo "$local_oid~1")
  else
    base="$remote_oid"
  fi
  if git diff --name-only "$base" "$local_oid" | grep -q '^apps/demo/'; then
    demo_changed=1
  fi
done

if [ -n "$demo_changed" ]; then
  echo "pre-push: apps/demo changed; building and running pa11y accessibility audit..."
  pnpm --filter @maskera/demo build
  pnpm --filter @maskera/demo audit:a11y
fi
