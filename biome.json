{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/training/.venv",
      "!**/bench/.venv-*",
      "!**/bench/out",
      "!**/bench/corpora",
      "!**/training/model*",
      "!**/training/onnx-model",
      "!**/training/student-*",
      "!**/training/data",
      "!**/apps/demo/public/models"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" }
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "formatter": { "enabled": false }
    }
  ]
}
