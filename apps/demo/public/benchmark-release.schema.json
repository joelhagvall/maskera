{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maskera.dev/benchmark-release.schema.json",
  "title": "Maskera published benchmark release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "release",
    "publishedAt",
    "lastMeasuredAt",
    "scope",
    "packages",
    "artifact",
    "whitepaper",
    "evaluation",
    "metrics",
    "historical"
  ],
  "properties": {
    "$schema": { "const": "https://maskera.dev/benchmark-release.schema.json" },
    "schemaVersion": { "const": 2 },
    "status": { "const": "published" },
    "release": { "$ref": "#/$defs/release" },
    "publishedAt": { "$ref": "#/$defs/date" },
    "lastMeasuredAt": { "$ref": "#/$defs/date" },
    "scope": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maskera", "core"],
      "properties": {
        "maskera": { "$ref": "#/$defs/semver" },
        "core": { "$ref": "#/$defs/semver" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "hubRepo",
        "revision",
        "dtype",
        "path",
        "sha256",
        "bytes",
        "modelCardSha256"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "hubRepo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "revision": { "$ref": "#/$defs/gitSha" },
        "dtype": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "modelCardSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "whitepaper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "sourceSha256", "pdf", "pdfSha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "source": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "pdf": { "type": "string", "minLength": 1 },
        "pdfSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "suiteSha256", "files", "environment"],
      "properties": {
        "command": { "const": "pnpm eval:release" },
        "suiteSha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "packageManager", "lockfile", "selectors", "ignoredPeers", "sha256"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "packageManager": {
              "type": "string",
              "pattern": "^pnpm@[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "lockfile": { "const": "pnpm-lock.yaml" },
            "selectors": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "ignoredPeers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curated",
        "syntheticAdr",
        "linkedinStyle",
        "syntheticGold",
        "rareSurnames",
        "structuredRegression",
        "clinicalCareSubset"
      ],
      "properties": {
        "curated": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/evaluationSet" }],
          "unevaluatedProperties": false
        },
        "syntheticAdr": {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/evaluationSet" },
            {
              "type": "object",
              "required": ["addresses", "addressPredictions"],
              "properties": {
                "addresses": { "$ref": "#/$defs/count" },
                "addressPredictions": { "$ref": "#/$defs/count" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "linkedinStyle": {
          "type": "object",
          "allOf": [
            { "$ref": "#/$defs/evaluationSet" },
            {
              "type": "object",
              "required": ["measuredAt"],
              "properties": { "measuredAt": { "$ref": "#/$defs/date" } }
            }
          ],
          "unevaluatedProperties": false
        },
        "syntheticGold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typeF1Pct",
            "typeRecallPct",
            "maskedRecallPct",
            "typeF1FloorPct",
            "typeRecallFloorPct",
            "maskedRecallFloorPct"
          ],
          "properties": {
            "typeF1Pct": { "$ref": "#/$defs/percentage" },
            "typeRecallPct": { "$ref": "#/$defs/percentage" },
            "maskedRecallPct": { "$ref": "#/$defs/percentage" },
            "typeF1FloorPct": { "$ref": "#/$defs/percentage" },
            "typeRecallFloorPct": { "$ref": "#/$defs/percentage" },
            "maskedRecallFloorPct": { "$ref": "#/$defs/percentage" }
          }
        },
        "rareSurnames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entities", "masked", "maskedRecallPct", "personTypedRecallPct", "leaks"],
          "properties": {
            "entities": { "$ref": "#/$defs/count" },
            "masked": { "$ref": "#/$defs/count" },
            "maskedRecallPct": { "$ref": "#/$defs/percentage" },
            "personTypedRecallPct": { "$ref": "#/$defs/percentage" },
            "leaks": { "$ref": "#/$defs/count" }
          }
        },
        "structuredRegression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documents",
            "entities",
            "fullHits",
            "partialLeaks",
            "misses",
            "hitRatePct",
            "redactions",
            "classifiedJunk"
          ],
          "properties": {
            "documents": { "$ref": "#/$defs/count" },
            "entities": { "$ref": "#/$defs/count" },
            "fullHits": { "$ref": "#/$defs/count" },
            "partialLeaks": { "$ref": "#/$defs/count" },
            "misses": { "$ref": "#/$defs/count" },
            "hitRatePct": { "$ref": "#/$defs/percentage" },
            "redactions": { "$ref": "#/$defs/count" },
            "classifiedJunk": { "$ref": "#/$defs/count" }
          }
        },
        "clinicalCareSubset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entities",
            "generalHits",
            "clinicalHits",
            "generalClassifiedJunk",
            "clinicalClassifiedJunk"
          ],
          "properties": {
            "entities": { "$ref": "#/$defs/count" },
            "generalHits": { "$ref": "#/$defs/count" },
            "clinicalHits": { "$ref": "#/$defs/count" },
            "generalClassifiedJunk": { "$ref": "#/$defs/count" },
            "clinicalClassifiedJunk": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "measuredAt",
        "packageVersion",
        "status",
        "curated",
        "independentGold",
        "address"
      ],
      "properties": {
        "release": { "$ref": "#/$defs/release" },
        "measuredAt": { "$ref": "#/$defs/date" },
        "packageVersion": { "$ref": "#/$defs/semver" },
        "status": { "type": "string", "pattern": "^historical-only-not-a-v[0-9]+-result$" },
        "curated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documents", "entities", "spanF1Pct", "leaks"],
          "properties": {
            "documents": { "$ref": "#/$defs/count" },
            "entities": { "$ref": "#/$defs/count" },
            "spanF1Pct": { "$ref": "#/$defs/percentage" },
            "leaks": { "$ref": "#/$defs/count" }
          }
        },
        "independentGold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documents", "entities", "precisionPct", "recallPct", "spanF1Pct", "leaks"],
          "properties": {
            "documents": { "$ref": "#/$defs/count" },
            "entities": { "$ref": "#/$defs/count" },
            "precisionPct": { "$ref": "#/$defs/percentage" },
            "recallPct": { "$ref": "#/$defs/percentage" },
            "spanF1Pct": { "$ref": "#/$defs/percentage" },
            "leaks": { "$ref": "#/$defs/count" }
          }
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["addresses", "spanF1Pct", "leaks"],
          "properties": {
            "addresses": { "$ref": "#/$defs/count" },
            "spanF1Pct": { "$ref": "#/$defs/percentage" },
            "leaks": { "$ref": "#/$defs/count" }
          }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "evaluationSet": {
      "type": "object",
      "required": [
        "documents",
        "entities",
        "precisionPct",
        "recallPct",
        "spanF1Pct",
        "labeledF1Pct",
        "leaks"
      ],
      "properties": {
        "documents": { "$ref": "#/$defs/count" },
        "entities": { "$ref": "#/$defs/count" },
        "precisionPct": { "$ref": "#/$defs/percentage" },
        "recallPct": { "$ref": "#/$defs/percentage" },
        "spanF1Pct": { "$ref": "#/$defs/percentage" },
        "labeledF1Pct": { "$ref": "#/$defs/percentage" },
        "leaks": { "$ref": "#/$defs/count" }
      }
    },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "percentage": {
      "type": "string",
      "pattern": "^(100(?:\\.0+)?|[0-9]{1,2}(?:\\.[0-9]+)?)$"
    },
    "release": { "type": "string", "pattern": "^v[0-9]+$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
