{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/developers", "destination": "/utvecklare", "permanent": true }],
  "rewrites": [
    { "source": "/utvecklare", "destination": "/utvecklare/index.html" },
    { "source": "/integritet", "destination": "/integritet/index.html" },
    { "source": "/testdata", "destination": "/testdata/index.html" },
    { "source": "/integritetspolicy", "destination": "/integritetspolicy/index.html" },
    { "source": "/tjanster", "destination": "/tjanster/index.html" },
    { "source": "/traffsakerhet", "destination": "/traffsakerhet/index.html" },
    { "source": "/sakerhet", "destination": "/sakerhet/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/developers", "destination": "/en/developers/index.html" },
    { "source": "/en/privacy", "destination": "/en/privacy/index.html" },
    { "source": "/en/test-data", "destination": "/en/test-data/index.html" },
    { "source": "/en/privacy-policy", "destination": "/en/privacy-policy/index.html" },
    { "source": "/en/services", "destination": "/en/services/index.html" },
    { "source": "/en/accuracy", "destination": "/en/accuracy/index.html" },
    { "source": "/en/security", "destination": "/en/security/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), clipboard-write=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/maskera-sv-ner-v19/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
