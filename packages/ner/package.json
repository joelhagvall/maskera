{
  "name": "maskera",
  "version": "0.9.4",
  "description": "Swedish-first, client-side PII redaction: deterministic rule detectors plus an optional ONNX/Transformers.js NER model for free-text names, places, organisations and street addresses.",
  "type": "module",
  "license": "MIT",
  "author": "Joel Hägvall",
  "keywords": [
    "pii",
    "ner",
    "transformers.js",
    "onnx",
    "swedish",
    "privacy",
    "redaction"
  ],
  "homepage": "https://maskera.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelhagvall/maskera.git",
    "directory": "packages/ner"
  },
  "bugs": "https://github.com/joelhagvall/maskera/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "eval": "node eval/run-eval.mjs",
    "eval:domain": "node eval/domain-regression/run.mjs"
  },
  "dependencies": {
    "@maskera/core": "workspace:^"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
