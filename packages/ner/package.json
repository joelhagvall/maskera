{
  "name": "@maskera/ner",
  "version": "0.1.0",
  "description": "Opt-in ONNX/Transformers.js NER layer for maskera — detects free-text names, places and organisations the rule layer can't.",
  "type": "module",
  "license": "MIT",
  "author": "Joel Hägvall",
  "keywords": ["pii", "ner", "transformers.js", "onnx", "swedish", "privacy", "redaction"],
  "homepage": "https://github.com/joelhagvall/maskera#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelhagvall/maskera.git",
    "directory": "packages/ner"
  },
  "bugs": "https://github.com/joelhagvall/maskera/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "NOTICE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "eval": "node eval/run-eval.mjs"
  },
  "dependencies": {
    "@maskera/core": "workspace:^"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
