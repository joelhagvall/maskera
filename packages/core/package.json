{
  "name": "@maskera/core",
  "version": "0.4.0",
  "description": "Swedish-first, zero-dependency PII detection & redaction. Runs in the browser, Node, and edge.",
  "type": "module",
  "license": "MIT",
  "author": "Joel Hägvall",
  "keywords": [
    "pii",
    "redaction",
    "anonymization",
    "gdpr",
    "swedish",
    "personnummer",
    "privacy",
    "llm",
    "ai"
  ],
  "homepage": "https://maskera.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelhagvall/maskera.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/joelhagvall/maskera/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
